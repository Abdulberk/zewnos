# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
# .env dosyasi .gitignore icindedir, asla commit edilmez.

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model secimi (bkz. README > "Model secimi ve maliyet"):
#   claude-sonnet-5 + medium -> tam analiz ~$0.22, ~25sn/cagri  (gelistirme)
#   claude-opus-5   + medium -> tam analiz ~$0.72, ~55sn/cagri  (teslim)
# Opus donemsel atif dogrulugunda ve aksiyon derinliginde belirgin sekilde iyi.
AI_MODEL=claude-sonnet-5
AI_EFFORT=medium
AI_MAX_TOKENS=12000

# AI cagrilarinin es zamanlilik siniri (rate limit korumasi)
AI_MAX_CONCURRENCY=6

# --- uygulama ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./sonart.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760

# AI analiz sonuclarini onbellekten servis et (demo hizi + maliyet)
AI_CACHE_ENABLED=true
