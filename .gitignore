# --- runtime data ---
# Calisma zamaninda uretilen her sey. Ornek bir cikti raporu
# docs/ornek-rapor.pdf olarak ayrica saklaniyor.
storage/*
!storage/uploads/
storage/uploads/*
!storage/uploads/.gitkeep
*.db
*.sqlite3

# --- demo tohum verisi (istisna) ---
# Render'in diski kalicidegil: her yeniden baslatmada calisma zamani
# dosyalari silinir. Demo ortaminin bos acilmamasi icin ornek veri
# setleri ve onlarin uretilmis analizleri depoda tutuluyor.
# Uretim ortaminda bunlarin yeri veritabani ve nesne deposudur.
!sonart.db
!storage/uploads/*.csv

